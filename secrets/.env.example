# Logging
DATA_ACQ_LOG_LEVEL=1
FRONTEND_LOG_LEVEL=6

# Spotify
SPOTIFY_CID=
SPOTIFY_SECRET=
SPOTIFY_REDIRECT=http://kong:8000/functions/v1/spotify-callback
SPOTIFY_REFRESH= # Spotify refresh token, used for testing

# Apple / Apple Music
APPLE_MEDIA_KEY_PATH=secrets/AuthKey_XXXXXXXXXX.p8
APPLE_MEDIA_KEY_ID=
APPLE_TEAM_ID=
APP_URL=https://local.tile.music

# Postgres
PG_USER=postgres
PG_PW=
PG_HOST=localhost
PG_PORT=5433
PG_DB=postgres
PG_PORT=3001

# Data Acquisition
DATA_ACQ_URL=http://data-acquisition:3001

# Frontend
EXTERNAL_SUPABASE_URL=http://127.0.0.1:8000
TEST_SUPABASE_URL=http://127.0.0.1:8000
FRONTEND_URL=https://local.tile.music

# Supabase
SB_URL=http://kong:8000/
SB_URL_TEST=http://127.0.0.1:8000/
SB_ANON_KEY=your-super-secret-and-long-supabase-anon-key
SB_SERVICE_KEY=your-super-secret-and-long-supabase-service-key

SB_POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password
SB_JWT_SECRET=your-super-secret-and-at-least-32-characters-long-jwt-secret
SB_DASHBOARD_USERNAME=supabase
SB_DASHBOARD_PASSWORD=your-super-secret-and-long-dashboard-password
SB_SECRET_KEY_BASE=your-super-secret-and-long-key-base
SB_VAULT_ENC_KEY=your-super-secret-and-long-vault-encryption-key

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres

POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=60
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=mdv
POOLER_DB_POOL_SIZE=10

KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

PGRST_DB_SCHEMAS=public

## General
ADDITIONAL_REDIRECT_URLS=https://local.tile.music/oauth/**
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
API_EXTERNAL_URL=http://localhost:8000

## Mailer Config
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

## Email auth
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
SMTP_ADMIN_EMAIL=api@bixler.me
SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=api
SMTP_PASS=your-longish-smtp-pass
SMTP_SENDER_NAME=musicdatavis
ENABLE_ANONYMOUS_USERS=false

## Phone auth
ENABLE_PHONE_SIGNUP=true
ENABLE_PHONE_AUTOCONFIRM=true

## Spotify OAuth
EXTERNAL_SPOTIFY_ENABLED=true
EXTERNAL_SPOTIFY_CLIENT_ID=spotify-client-id
EXTERNAL_SPOTIFY_SECRET=spotify-secret
EXTERNAL_SPOTIFY_REDIRECT_URI=https://local.tile.music/oauth/callback

## Apple Music OAuth
EXTERNAL_APPLE_ENABLED=true
EXTERNAL_APPLE_CLIENT_ID=com.tile.music.web
EXTERNAL_APPLE_SECRET=put-your-generated-developer-token-here-valid-for-6-months
EXTERNAL_APPLE_REDIRECT_URI=https://local.tile.music/oauth/callback

## Enable users to link accounts that don't share a common email
ENABLE_MANUAL_LINKING=true

STUDIO_DEFAULT_ORGANIZATION=tile.music
STUDIO_DEFAULT_PROJECT=tile.music
STUDIO_PORT=3000
SUPABASE_PUBLIC_URL=http://0.0.0.0:8000

LOGFLARE_LOGGER_BACKEND_API_KEY=your-super-secret-and-long-logflare-key
LOGFLARE_PUBLIC_ACCESS_TOKEN=your-super-secret-and-long-logflare-key-public
LOGFLARE_PRIVATE_ACCESS_TOKEN=your-super-secret-and-long-logflare-key-private
